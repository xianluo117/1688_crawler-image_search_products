# 使用三个相互独立的随机值，不得提交真实密钥。
# Linux 生成示例：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
COOKIE_SYNC_SHARED_SECRET=replace-with-at-least-32-random-characters
COOKIE_ENCRYPTION_KEY=replace-with-another-at-least-32-random-characters
ALI1688_API_KEY=replace-with-third-at-least-32-random-characters

# 加密 Cookie 文件和临时上传目录
ALI1688_COOKIE_FILE=runtime/ali1688.cookies.enc
ALI1688_UPLOAD_TEMP_DIR=runtime/uploads

# 接收请求允许的最大时间偏差，单位：秒，范围 30-900
COOKIE_SYNC_MAX_CLOCK_SKEW=300

# 远程 API 图片大小限制，单位：MB，范围 1-50
ALI1688_MAX_IMAGE_MB=10
